<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houduanbuke.mapper.userMapper">

    <insert id="register" databaseId="com.houduanbuke.pojo.User">
        insert into users (username,email,password,nickname) values (#{username},#{email},#{password},#{nickname})
    </insert>

    <select id="findAll" databaseId="com.houduanbuke.pojo.User">
        select username,email,password,nickname from users
    </select>

</mapper>